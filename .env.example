NODE_ENV=development
DATABASE_URL=postgres://globortunity:change-me@postgres:5432/globortunity
POSTGRES_DB=globortunity
POSTGRES_USER=globortunity
POSTGRES_PASSWORD=change-me
API_PORT=3000
WEB_PORT=8080
APP_HOST=47.109.60.123
APP_PUBLIC_URL=http://47.109.60.123
TLS_ENABLED=false
CORS_ORIGIN=http://localhost:5173

# Public feeds with explicit aggregator APIs. Both require attribution links, which the UI preserves.
PUBLIC_FEEDS_ENABLED=true
HIMALAYAS_MAX_PAGES=100
HIMALAYAS_DELAY_MS=1000
# Demo records are useful for an empty local database, but should be disabled for a live feed.
DEMO_SOURCE_ENABLED=false
COLLECTOR_INTERVAL_MS=900000

# Policy gate: enabling these flags does not implement or bypass BOSS access.
CRAWLING_ENABLED=false
BOSS_SOURCE_ENABLED=false
BOSS_AUTHORIZED_ACCESS=false
BOSS_REQUESTS_PER_MINUTE=6
BOSS_DAILY_REQUEST_BUDGET=500

# Assign proxy variables only to services that actually require them.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,api,web,worker
